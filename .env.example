# Copy this file to .env in the repository root. Docker Compose, backend
# services, and the frontend all use this single environment file.

# Shared application settings
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080
MAX_UPLOAD_SIZE_MB=20
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
TRUST_COMPANY_HEADER=true

# Auth
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_AT_LEAST_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Databases
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db
SLACK_CONNECTOR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slack_connector_db
EMAIL_CONNECTOR_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_connector_db
INVOICE_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_service_db
DOCUMENTS_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/documents_service_db
VENDORS_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vendors_service_db
TRANSACTIONS_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/transactions_service_db
HR_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hr_service_db
PROCUREMENT_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/procurement_service_db
SETTINGS_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/settings_service_db
REPORTS_SERVICE_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/reports_service_db

# Service database setting. Compose overrides DATABASE_URL with the correct
# container hostname for each service; this localhost value is for local runs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_service_db

# Redis
REDIS_URL=redis://localhost:6379/7
AUTH_REDIS_URL=redis://localhost:6379/6
SLACK_REDIS_URL=redis://localhost:6379/3
EMAIL_REDIS_URL=redis://localhost:6379/8
EMAIL_CELERY_BROKER_URL=redis://localhost:6379/9
EMAIL_CELERY_RESULT_BACKEND=redis://localhost:6379/10
SLACK_CELERY_BROKER_URL=redis://localhost:6379/4
SLACK_CELERY_RESULT_BACKEND=redis://localhost:6379/5

# Object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=invoice-service-files

# Internal service URLs (Compose replaces localhost where required)
AUTH_SERVICE_URL=http://localhost:8001
SLACK_CONNECTOR_URL=http://localhost:8010
EMAIL_CONNECTOR_URL=http://localhost:8011
INVOICE_SERVICE_URL=http://localhost:8002
DOCUMENTS_SERVICE_URL=http://localhost:8013
VENDORS_SERVICE_URL=http://localhost:8006
TRANSACTIONS_SERVICE_URL=http://localhost:8003
HR_SERVICE_URL=http://localhost:8004
PROCUREMENT_SERVICE_URL=http://localhost:8005
SETTINGS_SERVICE_URL=http://localhost:8009
REPORTS_SERVICE_URL=http://localhost:8014
AI_ENGINE_URL=http://localhost:8007
PADDLEOCR_SERVICE_URL=http://localhost:8008
INVOICE_SERVICE_TIMEOUT_SECONDS=15
AI_ENGINE_TIMEOUT_SECONDS=240
SETTINGS_SERVICE_TIMEOUT_SECONDS=10
TRANSACTIONS_SERVICE_TIMEOUT_SECONDS=10
UPSTREAM_TIMEOUT_SECONDS=20
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_USER=1000
PROXY_TIMEOUT_SECONDS=120

# OCR
OCR_ENGINE=liteparse
OCR_LANGUAGE=en
PADDLEOCR_LANG=en
PADDLEOCR_ENABLE_MKLDNN=false
PADDLEOCR_DEVICE=cpu
PADDLEOCR_MODEL_TIER=mobile

# Slack OAuth
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:8010/api/v1/slack/callback
SLACK_DEV_BOT_TOKEN=

# Email OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8011/api/v1/email/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8011/api/v1/email/callback
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
SCHEDULED_SYNC_MINUTES=30