DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoice_service_db
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=invoice-service-files

# Phase 2b's AI Engine — a plain internal HTTP call, no queue yet. See
# docs/invoice-ocr-plan.md §11b. 240s (not the LiteParse+PaddleOCR migration's
# originally-assumed sub-second budget) — confirmed live post-migration that a
# real scanned/OCR'd image routinely takes 10-150s+ through PaddleOCR under
# this project's dev-environment resource limits, occasionally more on a cold
# engine start; a shorter timeout was failing real scans outright with a 502
# rather than just being slow.
AI_ENGINE_URL=http://ai-engine:8007
AI_ENGINE_TIMEOUT_SECONDS=240

# Sales-invoice PDF branding (logo, placement, template) — best-effort;
# an unreachable Settings Service still produces a plain-classic PDF.
SETTINGS_SERVICE_URL=http://settings-service:8009
SETTINGS_SERVICE_TIMEOUT_SECONDS=10

# Matches the architecture report's stated invoice-upload cap (§11).
MAX_UPLOAD_SIZE_MB=20

# Must be IDENTICAL to the Auth Service's JWT_SECRET_KEY, or the tokens it
# issues will be rejected here.
JWT_SECRET_KEY=REPLACE_WITH_THE_SAME_SECRET_AS_THE_AUTH_SERVICE

# Interim auth shim — same convention as every other connector/service.
# Any valid UUID; the single "dev company" every request is scoped to when
# no bearer token is present. Refused outright when APP_ENV=production.
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001

# Dev only. Accepts an unverified X-Company-ID header when no bearer token
# is present. Must be false in production — the service refuses to start
# if this is true with APP_ENV=production.
TRUST_COMPANY_HEADER=true
