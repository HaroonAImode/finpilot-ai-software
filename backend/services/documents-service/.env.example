DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/documents_service_db
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=documents-service-files

INVOICE_SERVICE_URL=http://invoice-service:8002
INVOICE_SERVICE_TIMEOUT_SECONDS=240

MAX_UPLOAD_SIZE_MB=20

# Identical to the Auth Service's JWT_SECRET_KEY so tokens it issues verify here.
JWT_SECRET_KEY=REPLACE_WITH_THE_SAME_SECRET_AS_THE_AUTH_SERVICE

DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
TRUST_COMPANY_HEADER=true
