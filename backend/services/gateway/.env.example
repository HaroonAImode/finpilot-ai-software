# Must be IDENTICAL to the Auth Service's JWT_SECRET_KEY — the Gateway verifies
# the tokens that service signs.
JWT_SECRET_KEY=REPLACE_WITH_THE_SAME_SECRET_AS_THE_AUTH_SERVICE

AUTH_SERVICE_URL=http://auth:8001
SLACK_CONNECTOR_URL=http://slack-connector:8010
EMAIL_CONNECTOR_URL=http://email-connector:8011
INVOICE_SERVICE_URL=http://invoice-service:8002
DOCUMENTS_SERVICE_URL=http://documents-service:8013
VENDORS_SERVICE_URL=http://vendors-service:8006
TRANSACTIONS_SERVICE_URL=http://transactions-service:8003
HR_SERVICE_URL=http://hr-service:8004
PROCUREMENT_SERVICE_URL=http://procurement-service:8005
SETTINGS_SERVICE_URL=http://settings-service:8009
REPORTS_SERVICE_URL=http://reports-service:8014

REDIS_URL=redis://redis:6379/7
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080

# Architecture report §20
RATE_LIMIT_PER_IP=100
RATE_LIMIT_PER_USER=1000
PROXY_TIMEOUT_SECONDS=120
