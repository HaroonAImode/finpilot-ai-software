# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Redirect URI registered there must exactly match GOOGLE_REDIRECT_URI below.
# gmail.readonly is a restricted scope — Google's app verification review is
# required before this can run outside test mode (100 test users, no review
# needed). See docs/email-connector-plan.md §12.1.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8011/api/v1/email/callback

# Azure Portal → App registrations → New registration → "Accounts in any
# organizational directory and personal Microsoft accounts" (multi-tenant +
# personal — matches the "common" tenant this service authorizes against).
# Then Certificates & secrets → New client secret, and API permissions →
# Microsoft Graph → Delegated → Mail.Read, offline_access. Redirect URI
# registered there must exactly match MICROSOFT_REDIRECT_URI below. Optional:
# leave unset and Outlook connect requests return a clean 503 rather than
# failing at startup — a Gmail-only deployment does not need these. See
# docs/email-connector-plan.md §11a.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:8011/api/v1/email/callback

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_connector_db
REDIS_URL=redis://localhost:6379/8
CELERY_BROKER_URL=redis://localhost:6379/9
CELERY_RESULT_BACKEND=redis://localhost:6379/10
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=email-connector-files
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080

# Interim auth shim — same convention as slack-connector's. Any valid UUID;
# the single "dev company" every request is scoped to when no bearer token
# is present. Refused outright when APP_ENV=production.
DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001

INVOICE_SERVICE_URL=http://invoice:8002

# How often (minutes) Celery Beat queues an incremental sync for every
# connected account. 0 disables scheduling — useful when running the worker
# ad-hoc without also wanting a background scheduler.
SCHEDULED_SYNC_MINUTES=30

# Must be IDENTICAL to the Auth Service's JWT_SECRET_KEY, or the tokens it
# issues will be rejected here.
JWT_SECRET_KEY=REPLACE_WITH_THE_SAME_SECRET_AS_THE_AUTH_SERVICE

# Dev only. Accepts an unverified X-Company-ID header when no bearer token is
# present. Must be false in production — a mailbox is more sensitive than a
# Slack channel, so this shim is even less acceptable to leave on by accident
# than it already was for Slack. The service refuses to start if this is
# true with APP_ENV=production.
TRUST_COMPANY_HEADER=true
