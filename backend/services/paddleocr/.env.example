APP_ENV=development
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20

# Language passed to PaddleOCR's model selection. "en" is what this project
# has verified live against real English-language Pakistani/Indian
# invoices/receipts — change only after verifying the target language's
# model actually performs well against real documents, same discipline
# every other part of this pipeline follows.
PADDLEOCR_LANG=en

# Required =False on this project's Windows dev host — PP-OCRv6 + oneDNN
# raises a PIR-compiler NotImplementedError on CPU inference otherwise
# (confirmed live during the LiteParse+PaddleOCR migration). Re-verify on
# the actual Linux container target before ever flipping this to True —
# oneDNN issues are sometimes platform-specific, and this has only been
# confirmed broken on Windows, not confirmed safe on Linux.
PADDLEOCR_ENABLE_MKLDNN=false
PADDLEOCR_DEVICE=cpu

# Model tier: "mobile" or "server". Both are PP-OCRv5 detection+recognition
# — neither is an LLM. Measured on this project's own real invoice on the
# dev host (8 CPU / 4.8GB to Docker): mobile ~150-350s per page, server
# ~460s through the pipeline and a direct call timed out at 900s, for no
# clear net accuracy win (better line items, but it lost the invoice date).
# "server" is likely right on a host with real CPU headroom.
# Baked into the image at build time, so changing this needs a rebuild.
PADDLEOCR_MODEL_TIER=mobile
