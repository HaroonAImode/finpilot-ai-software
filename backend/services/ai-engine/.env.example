APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080

# Matches the architecture report's stated invoice-upload cap (§11).
MAX_UPLOAD_SIZE_MB=20

# LiteParse+PaddleOCR migration (docs/invoice-ocr-plan.md) — "liteparse" is
# the new default primary path (native text -> PaddleOCR -> LiteParse's own
# built-in OCR); "tesseract" is a one-variable rollback to the original,
# fully unmodified PyMuPDF+pytesseract pipeline this project already had.
OCR_ENGINE=liteparse
# Internal URL of the paddleocr service (see docker-compose.yml) — LiteParse's
# external-OCR-server config. If unset/unreachable, the liteparse engine
# falls back to its own built-in OCR rather than failing.
PADDLEOCR_SERVICE_URL=http://paddleocr:8008
OCR_LANGUAGE=en
