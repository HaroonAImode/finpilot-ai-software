DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hr_service_db
APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_BASE_URL=http://localhost:8080

# Payroll processing books a matching Expense here, best-effort.
TRANSACTIONS_SERVICE_URL=http://transactions-service:8003
TRANSACTIONS_SERVICE_TIMEOUT_SECONDS=10

# Identical to the Auth Service's JWT_SECRET_KEY so tokens it issues verify here.
JWT_SECRET_KEY=REPLACE_WITH_THE_SAME_SECRET_AS_THE_AUTH_SERVICE

DEFAULT_COMPANY_ID=00000000-0000-0000-0000-000000000001
TRUST_COMPANY_HEADER=true
